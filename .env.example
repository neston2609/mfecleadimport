HOST=127.0.0.1
PORT=3002
# Optional Vite proxy override when PORT is changed.
API_PROXY_TARGET=http://127.0.0.1:3002
APP_SECRET=replace-with-a-persistent-random-32-byte-value
SESSION_SECRET=replace-with-a-different-random-32-byte-value
# Server-local CSV/JSON browser roots (macOS/Linux use colon separators; Windows uses semicolons).
# Defaults to DATA_DIR/source-inputs. Keep roots limited to data folders the app may read.
SOURCE_FILE_ROOTS=
# Optional exact remote hostnames/IPs administrators explicitly permit even when private/link-local.
SOURCE_REMOTE_ALLOWED_HOSTS=
ADMIN_USERNAME=admin
# Bootstrap only; remove after the first successful start.
ADMIN_PASSWORD=replace-with-a-strong-unique-password
