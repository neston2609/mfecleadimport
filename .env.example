HOST=127.0.0.1
PORT=3002
# Optional Vite proxy override when PORT is changed.
API_PROXY_TARGET=http://127.0.0.1:3002
APP_SECRET=replace-with-a-persistent-random-32-byte-value
SESSION_SECRET=replace-with-a-different-random-32-byte-value
ADMIN_USERNAME=admin
# Bootstrap only; remove after the first successful start.
ADMIN_PASSWORD=replace-with-a-strong-unique-password
